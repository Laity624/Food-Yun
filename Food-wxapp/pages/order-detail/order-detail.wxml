<view class="order-detail-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <van-loading size="24px" />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 订单详情 -->
  <view wx:elif="{{order}}" class="order-content">
    <!-- 订单头部 -->
    <view class="order-header">
      <view class="order-title">
        <text class="meal-icon">{{getMealTypeIcon(order.mealType)}}</text>
        <text class="meal-type">{{order.mealTypeLabel}}订单</text>
        <view class="status-badge status-{{order.status}}">
          <text class="status-text">{{order.statusLabel}}</text>
        </view>
      </view>
      <text class="order-no">订单号：{{order.orderNo}}</text>
    </view>

    <!-- 订单信息 -->
    <view class="order-info">
      <view class="info-item">
        <text class="info-label">订餐者</text>
        <view class="info-value">
          <image class="assignee-avatar" src="{{order.creatorAvatar}}" mode="aspectFill" />
          <text class="assignee-name">{{order.creatorName}}</text>
        </view>
      </view>
      <view class="info-item">
        <text class="info-label">厨师</text>
        <view class="info-value">
          <image class="assignee-avatar" src="{{order.assigneeAvatar}}" mode="aspectFill" />
          <text class="assignee-name">{{order.assigneeName}}</text>
        </view>
      </view>
      
      <view class="info-item">
        <text class="info-label">制作时间</text>
        <text class="info-value">{{order.orderDate}}</text>
      </view>
      
      <view class="info-item">
        <text class="info-label">预计用时</text>
        <text class="info-value">{{order.estimatedTime}}小时</text>
      </view>
      
      <view wx:if="{{order.notes}}" class="info-item">
        <text class="info-label">备注信息</text>
        <text class="info-value notes">{{order.notes}}</text>
      </view>
    </view>

    <!-- 菜品列表 -->
    <view class="recipes-section">
      <view class="section-title">
        <text>菜品详情 ({{order.totalRecipes}}道)</text>
      </view>
      
      <view class="recipes-list">
        <view 
          wx:for="{{order.recipes}}" 
          wx:key="recipeId"
          class="recipe-item"
          data-recipe-id="{{item.recipeId}}"
          bindtap="onViewRecipe"
        >
          <image class="recipe-image" src="{{item.image}}" mode="aspectFill" />
          <view class="recipe-info">
            <text class="recipe-name">{{item.recipeName}}</text>
            <view class="recipe-meta">
              <text class="meta-item">作者：{{item.authorName}}</text>
              <text class="meta-item">⏰ {{item.preparationTime}}</text>
              <text class="meta-item">⭐ {{item.difficulty}}</text>
            </view>
          </view>
          <van-icon name="arrow" size="16px" color="#999" />
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <!-- 待处理状态 -->
      <view wx:if="{{order.status === 'pending'}}" class="button-group">
        <van-button 
          type="primary"
          size="large"
          bind:click="startCooking"
          custom-style="flex: 1; margin-right: 12rpx;"
          wx:if="{{order.assigneeId === userInfo.openid}}"
        >
          开始制作
        </van-button>
        <van-button 
          type="default"
          size="large"
          bind:click="cancelOrder"
          custom-style="flex: 1;"
        >
          取消订单
        </van-button>
      </view>
      
      <!-- 处理中状态 -->
      <view wx:elif="{{order.status === 'processing'}}" class="button-group">
        <van-button 
          type="success"
          size="large"
          bind:click="completeCooking"
          custom-style="flex: 1; margin-right: 12rpx;"
          wx:if="{{order.assigneeId === userInfo.openid}}"
        >
          完成制作
        </van-button>
        <van-button 
          type="default"
          size="large"
          bind:click="cancelOrder"
          custom-style="flex: 1;"
        >
          取消订单
        </van-button>
      </view>
      
      <!-- 已完成状态 -->
      <van-button 
        wx:elif="{{order.status === 'completed'}}"
        type="primary"
        size="large"
        bind:click="reorder"
        custom-style="flex: 1;"
      >
        再次点餐
      </van-button>
      
      <!-- 已取消状态 -->
      <van-button 
        wx:elif="{{order.status === 'cancelled'}}"
        type="primary"
        size="large"
        bind:click="reorder"
        custom-style="flex: 1;"
      >
        再次点餐
      </van-button>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:else class="error-state">
    <text class="error-emoji">😵</text>
    <text class="error-title">订单不存在</text>
    <text class="error-desc">请检查订单ID是否正确</text>
    <van-button type="primary" size="large" bind:click="onGoBack">
      返回订单列表
    </van-button>
  </view>
</view>

