/* 订单列表页面样式 */
.order-list-container {
  height: 100vh;
  background-color: #f8fafc;
  padding-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  
}

/* 头部 */
.header-section {
  background-color: #ffffff;
  padding: 20rpx 32rpx 10rpx;
  /* border-bottom: 1rpx solid #e2e8f0; */
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.search-btn {
  width: 72rpx;
  height: 72rpx;
  background-color: #f0f9ff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.search-btn:active {
  background-color: #e0f2fe;
  transform: scale(0.95);
}

.search-section {
  /* margin-top: 24rpx; */
}

/* 状态筛选 */
.status-tabs {
  background-color: #ffffff;
  /* border-bottom: 1rpx solid #e2e8f0; */
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs-list {
  display: flex;
  padding: 0 32rpx;
}

.tab-item {
  padding: 24rpx 24rpx;
  margin-right: 16rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.tab-item.active {
  border-bottom-color: #3b82f6;
}

.tab-item.active .tab-text {
  color: #3b82f6;
  font-weight: 600;
}

.tab-text {
  font-size: 28rpx;
  color: #6b7280;
  transition: all 0.3s ease;
}

/* 隐藏滚动条 */
scroll-view ::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

/* 订单列表 */
.orders-section {
  padding: 32rpx;
  flex: 1;
  overflow: hidden;
  display: flex;
}

.orders-scroll {
  height: 100%;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #6b7280;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 300rpx 0;
}

.empty-emoji {
  font-size: 80rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.empty-desc {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
}

.orders-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
  margin-bottom: 24rpx;
}

.order-card:active {
  transform: translateY(-1rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 订单头部 */
.order-header {
  margin-bottom: 24rpx;
}

.order-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6px 0 20rpx;
  border-bottom: 2rpx solid #f5f6f8;
  margin-bottom: 16rpx;
}

.order-time{
  /* display: flex;
  align-items: center; */
  line-height: 36rpx;
}

.meal-icon {
  font-size: 32rpx;
  margin-right: 6rpx;
}

.meal-type {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.order-date{
  font-size: 28rpx;
  /* font-weight: 600; */
  margin-left: 20rpx;
  color: #7a808d;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-pending {
  background-color: #fef3c7;
  color: #f59e0b;
}

.status-processing {
  background-color: #dbeafe;
  color: #3b82f6;
}

.status-completed {
  background-color: #e1f7e3;
  color: #0d996a;
}

.status-cancelled {
  background-color: #fee2e2;
  color: #ef4444;
}

.order-creator{
  display: flex;
  justify-content:space-between;
  align-items: center;
}

.order-no {
  font-size: 24rpx;
  color: #7f8899;
}

/* 制作者信息 */
.assignee-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx;
  /* background-color: #fcfcfc; */
  border-radius: 12rpx;
}

.assignee-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 32rpx;
}

.assignee-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-left: 10rpx;
}

.assignee-name {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.order-time {
  font-size: 24rpx;
  color: #6b7280;
}

/* 菜品预览 */
.recipes-preview {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0;
}

.recipe-grid {
  display: flex;
  gap: 20rpx;
  flex: 1;
  align-items: center;
}

.recipe-image-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  overflow: hidden;
  /* border: 1rpx solid #ebebeb; */
  flex-shrink: 0;
}

.recipe-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.recipe-info-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
  min-width: 100rpx;
}

.recipe-count {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 400;
  margin-bottom: 4rpx;
}

/* 操作按钮区域 */
.order-actions {
  display: flex;
  justify-content: flex-end;
}

.button-group {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  width: 100%;
}

.action-btn {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 20rpx;
}

.action-btn:active {
  transform: translateY(1rpx);
}

.action-btn.primary {
  background-color: #ef5350;
  color: #ffffff;
}

.action-btn.primary:active {
  background-color: #dc2626;
}

.action-btn.secondary {
  background-color: #ffffff;
  color: #575a5f;
  font-weight: normal;
  /* border: 1rpx solid #d1d5db; */
}

.action-btn.secondary:active {
  background-color: #f9fafb;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
  color: #6b7280;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #9ca3af;
  font-size: 24rpx;
}