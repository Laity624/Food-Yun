.recipe-detail-container {
  min-height: 100vh;
  background: #fafafa;
  position: relative;
  overflow-x: hidden;
}

/* 固定导航栏 */
.fixed-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 32rpx 48rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.nav-btn {
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.nav-btn:active {
  background: rgba(0, 0, 0, 0.1);
  transform: scale(0.95);
}

.nav-actions {
  display: flex;
  gap: 24rpx;
}

/* 图片轮播区域 */
.image-section {
  position: relative;
  height: 600rpx;
  overflow: hidden;
}

.recipe-swiper {
  width: 100%;
  height: 100%;
}

.recipe-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%);
  z-index: 1;
}

/* 菜谱信息 */
.recipe-info {
  position: absolute;
  bottom: 40rpx;
  left: 48rpx;
  right: 48rpx;
  color: white;
  z-index: 2;
}

.recipe-title {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.6);
  line-height: 1.2;
  display: block;
}

.recipe-subtitle {
  font-size: 32rpx;
  opacity: 0.95;
  margin-bottom: 32rpx;
  display: block;
  line-height: 1.4;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
}

.recipe-meta {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  background: rgba(255,255,255,0.25);
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-weight: 500;
}

/* 内容区域 */
.content-scroll {
  height: 100vh;
  background: transparent;
  padding-top: calc(120rpx + env(safe-area-inset-top));
}

.content-card {
  background: white;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -40rpx;
  position: relative;
  z-index: 5;
  min-height: calc(100vh - 600rpx - 120rpx);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
}

/* 通用区块样式 */
.section {
  padding: 40rpx 48rpx;
  border-bottom: 1px solid #f1f5f9;
}

.section:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: space-between;
}

.section-action {
  font-size: 24rpx;
  color: #3b82f6;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-text {
  font-size: 24rpx;
}

.action-link {
  font-size: 24rpx;
  color: #3b82f6;
}

/* 标签区域 */
.tag-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.recipe-tag {
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.recipe-tag:active {
  transform: scale(0.95);
}

.tag-emoji {
  font-size: 26rpx;
}

.tag-scene { 
  background: linear-gradient(135deg, #3b82f6, #2563eb); 
  color: white; 
}

.tag-ingredient { 
  background: linear-gradient(135deg, #10b981, #059669); 
  color: white; 
}

.tag-optional { 
  background: #fef3c7; 
  color: #d97706; 
}

/* 制作信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.info-item {
  text-align: center;
  padding: 32rpx 20rpx;
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  border-radius: 20rpx;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(226, 232, 240, 0.5);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.info-item:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.info-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.info-label {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

/* 食材清单 */
.ingredient-list {
  display: grid;
  gap: 24rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  border-radius: 16rpx;
  transition: all 0.3s ease;
  position: relative;
  border: 1rpx solid rgba(226, 232, 240, 0.5);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.ingredient-item:active {
  background: #e2e8f0;
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.ingredient-item.checked {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
  border: 2rpx solid #10b981;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.2);
}

.ingredient-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.ingredient-name {
  font-weight: 500;
  color: #1e293b;
  font-size: 28rpx;
}

.ingredient-amount {
  color: #3b82f6;
  font-weight: 500;
  font-size: 28rpx;
}

.ingredient-check {
  margin-left: 16rpx;
}

/* 制作步骤 */
.step-list {
  display: grid;
  gap: 40rpx;
}

.step-item {
  display: flex;
  gap: 32rpx;
  transition: all 0.3s ease;
}

.step-item.completed {
  opacity: 0.6;
}

.step-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.step-number {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 28rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.step-number.completed {
  background: linear-gradient(135deg, #10b981, #059669);
}

.step-check {
  margin-top: 8rpx;
}

.step-content {
  flex: 1;
  padding-top: 8rpx;
}

.step-text {
  color: #374151;
  line-height: 1.6;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.step-text.completed-text {
  text-decoration: line-through;
  color: #9ca3af;
}

.step-image-container {
  width: 100%;
  margin-top: 16rpx;
}

.step-image {
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx;
  transition: transform 0.2s ease;
}

.step-image:active {
  transform: scale(0.98);
}

/* 营养信息 */
.nutrition-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.nutrition-item {
  text-align: center;
  padding: 24rpx 16rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.nutrition-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1e293b;
}

.nutrition-unit {
  font-size: 20rpx;
  color: #64748b;
  margin-left: 4rpx;
}

.nutrition-name {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

/* 评价区域 */
.rating-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rating-display {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.rating-stars {
  display: flex;
  gap: 4rpx;
}

.rating-text {
  color: #64748b;
  font-size: 28rpx;
}

.rating-btn {
  padding: 16rpx 32rpx;
  background: #f1f5f9;
  color: #3b82f6;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.rating-btn:active {
  background: #e2e8f0;
  transform: scale(0.95);
}

/* 创建者信息 */
.creator-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.creator-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-text {
  color: white;
  font-weight: bold;
  font-size: 32rpx;
}

.creator-details {
  flex: 1;
}

.creator-name {
  font-weight: 500;
  color: #1e293b;
  font-size: 28rpx;
  display: block;
  margin-bottom: 8rpx;
}

.creator-date {
  font-size: 24rpx;
  color: #64748b;
  display: block;
}

.creator-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 相关推荐 */
.related-scroll {
  white-space: nowrap;
}

.related-list {
  display: flex;
  gap: 24rpx;
  padding-right: 48rpx;
}

.related-item {
  width: 240rpx;
  flex-shrink: 0;
}

.related-image {
  width: 240rpx;
  height: 180rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.related-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-meta {
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

/* 底部操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 32rpx 48rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f1f5f9;
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: 20rpx;
  z-index: 100;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  font-weight: 600;
  font-size: 28rpx;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.btn-secondary {
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  color: #64748b;
  border: 1rpx solid rgba(226, 232, 240, 0.5);
}

.btn-secondary:active {
  background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.btn-primary {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);
}

.btn-primary:active {
  transform: scale(0.95);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
}

/* 底部占位 */
.bottom-placeholder {
  height: 240rpx;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 1000;
}

.loading-text {
  font-size: 28rpx;
  color: #64748b;
}

/* 动画效果 */
.fade-in {
  animation: fadeIn 0.5s ease-in;
}

@keyframes fadeIn {
  from { 
    opacity: 0; 
    transform: translateY(40rpx); 
  }
  to { 
    opacity: 1; 
    transform: translateY(0); 
  }
}

.slide-up {
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { 
    transform: translateY(100%); 
  }
  to { 
    transform: translateY(0); 
  }
}

/* 响应式适配 */
@media (max-width: 320px) {
  .hero-section {
    height: 480rpx;
  }
  
  .recipe-title {
    font-size: 40rpx;
  }
  
  .info-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 24rpx;
  }
  
  .nutrition-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}